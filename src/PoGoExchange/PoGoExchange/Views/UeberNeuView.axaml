<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoGoExchange.ViewModels"
             xmlns:svc="using:PoGoExchange.Services"
             xmlns:views="using:PoGoExchange.Views"
             x:Class="PoGoExchange.Views.UeberNeuView"
             x:DataType="vm:UeberNeuViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="8">
      <TextBlock Text="Merkmale" FontWeight="Bold" />
      <views:ExemplarView DataContext="{Binding Merkmale}" />

      <TextBlock Text="Pokemon und Form w&#xE4;hlen" FontWeight="Bold" Margin="0,12,0,0" />
      <TextBlock Text="Suche (Name oder Dex-Nummer):" />
      <TextBox Text="{Binding Suchtext}" />
      <TextBlock Text="{Binding MehrHinweis}"
                 IsVisible="{Binding HatMehrHinweis}"
                 Foreground="DarkOrange"
                 TextWrapping="Wrap" />

      <ListBox ItemsSource="{Binding Ziele}"
               SelectedItem="{Binding Auswahl}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="svc:FormZiel">
            <TextBlock Text="{Binding Anzeige}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{Binding AuswahlText}" FontWeight="Bold" Margin="0,12,0,0"
                 TextWrapping="Wrap" />
      <Button Content="Speichern" Command="{Binding SpeichernCommand}" />
      <TextBlock Text="{Binding Meldung}"
                 IsVisible="{Binding HatMeldung}"
                 Foreground="Red"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

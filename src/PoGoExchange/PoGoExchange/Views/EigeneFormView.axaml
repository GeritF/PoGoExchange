<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoGoExchange.ViewModels"
             xmlns:svc="using:PoGoExchange.Services"
             xmlns:views="using:PoGoExchange.Views"
             x:Class="PoGoExchange.Views.EigeneFormView"
             x:DataType="vm:EigeneFormViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="8">
      <TextBlock Text="{Binding Kopf}"
                 IsVisible="{Binding HatKopf}"
                 FontSize="18"
                 TextWrapping="Wrap" />
      <TextBlock Text="Diese Form ist archiviert und kann nicht neu ausgew&#xE4;hlt werden."
                 IsVisible="{Binding Archiviert}"
                 TextWrapping="Wrap" />

      <StackPanel IsVisible="{Binding PokemonWaehlbar}" Spacing="8">
        <TextBlock Text="Pokemon w&#xE4;hlen" FontWeight="Bold" />
        <TextBlock Text="Suche (Name oder Dex-Nummer):" />
        <TextBox Text="{Binding Suchtext}" />
        <views:RegionFilterView DataContext="{Binding RegionFilter}" />
        <TextBlock Text="{Binding MehrHinweis}"
                   IsVisible="{Binding HatMehrHinweis}"
                   Foreground="DarkOrange"
                   TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Ziele}"
                 SelectedItem="{Binding Auswahl}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="svc:PokemonZiel">
              <TextBlock Text="{Binding Anzeige}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding AuswahlText}"
                   FontWeight="Bold"
                   TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Text="Form" FontWeight="Bold" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Form-Text:" VerticalAlignment="Center" Width="100" />
        <TextBox Text="{Binding FormText}" MinWidth="150" />
      </StackPanel>
      <TextBlock Text="leer = Grundform; z.B. &quot;Rot&quot;, &quot;XL&quot; oder &quot;?&quot;"
                 Opacity="0.6"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Region:" VerticalAlignment="Center" Width="100" />
        <ComboBox ItemsSource="{Binding Regionen}"
                  SelectedIndex="{Binding RegionIndex}"
                  MinWidth="150" />
      </StackPanel>
      <TextBlock Text="nur f&#xFC;r Regionalformen, z.B. Alola"
                 Opacity="0.6"
                 TextWrapping="Wrap" />
      <CheckBox Content="Shiny verf&#xFC;gbar"
                IsChecked="{Binding ShinyVerfuegbar}" />

      <Button Content="Speichern"
              Command="{Binding SpeichernCommand}"
              Margin="0,12,0,0" />
      <TextBlock Text="{Binding Meldung}"
                 IsVisible="{Binding HatMeldung}"
                 Foreground="Red"
                 TextWrapping="Wrap" />

      <StackPanel IsVisible="{Binding !IstNeu}"
                  Spacing="4"
                  Margin="0,12,0,0">
        <Button Content="L&#xF6;schen"
                Command="{Binding LoeschenCommand}" />
        <StackPanel IsVisible="{Binding LoeschRueckfrageSichtbar}"
                    Spacing="4">
          <TextBlock Text="Diese Form wirklich l&#xF6;schen?"
                     Foreground="Red"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Ja, l&#xF6;schen"
                    Command="{Binding LoeschenJaCommand}" />
            <Button Content="Nein"
                    Command="{Binding LoeschenNeinCommand}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

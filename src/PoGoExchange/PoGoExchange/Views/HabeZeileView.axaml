<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PoGoExchange.ViewModels"
             xmlns:views="using:PoGoExchange.Views"
             x:Class="PoGoExchange.Views.HabeZeileView"
             x:DataType="vm:HabeZeileViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="8">
      <TextBlock Text="{Binding Kopf}" FontSize="18" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Meldung}"
                 IsVisible="{Binding HatMeldung}"
                 Foreground="Green"
                 TextWrapping="Wrap" />

      <Button Content="Entwickeln" Command="{Binding EntwickelnCommand}" />

      <TextBlock Text="Merkmale (gelten f&#xFC;r die ganze Zeile)"
                 FontWeight="Bold" Margin="0,12,0,0" />
      <views:ExemplarView DataContext="{Binding Merkmale}" />
      <Button Content="Merkmale &#xFC;bernehmen"
              Command="{Binding MerkmaleUebernehmenCommand}" />

      <StackPanel IsVisible="{Binding KonfliktSichtbar}" Spacing="4">
        <TextBlock Text="{Binding KonfliktText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Ja" Command="{Binding KonfliktJaCommand}" />
          <Button Content="Nein" Command="{Binding KonfliktNeinCommand}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="Anzahl" FontWeight="Bold" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <NumericUpDown Value="{Binding Anzahl}"
                       Minimum="0" Increment="1" FormatString="0"
                       MinWidth="150" />
        <Button Content="Anzahl &#xFC;bernehmen"
                Command="{Binding AnzahlUebernehmenCommand}" />
      </StackPanel>

      <StackPanel IsVisible="{Binding LoeschRueckfrageSichtbar}" Spacing="4">
        <TextBlock Text="Anzahl 0 entfernt die Zeile vollst&#xE4;ndig. Wirklich l&#xF6;schen?"
                   Foreground="Red"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Ja, l&#xF6;schen" Command="{Binding LoeschenJaCommand}" />
          <Button Content="Nein" Command="{Binding LoeschenNeinCommand}" />
        </StackPanel>
      </StackPanel>

      <Button Content="L&#xF6;schen"
              Command="{Binding LoeschenCommand}"
              Margin="0,12,0,0" />
      <TextBlock Text="Setze die Anzahl auf 0, um die Zeile zu l&#xF6;schen."
                 IsVisible="{Binding LoeschHinweisSichtbar}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
